# Database
DATABASE_URL=sqlite:///./flakeguard.db

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=FlakeGuard AI
DEBUG=True

# ML Configuration
MODEL_DIR=../models
EXPERIMENT_DIR=../experiments
DATASET_DIR=../datasets

# Optional: LLM Integration (disabled by default)
OPENAI_API_KEY=
ENABLE_LLM_RECOMMENDATIONS=False

# Upload limits
MAX_UPLOAD_SIZE_MB=100

# Random seed for reproducibility
RANDOM_SEED=42
